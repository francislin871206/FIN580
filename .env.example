# ──────────────────────────────────────────────────────────────────────────────
# FIN580 Multi-Agent Trading System — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key (required for Agents 1, 2, 6)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI Key (required for Agent 1 live news fetching)
# Get yours at: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# FRED API Key (optional — for future macroeconomic data integration)
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
